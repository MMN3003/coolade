# Production backend: same runtime as the dev image, but ships only compiled
# bytecode (.pyc) - no .py source, tests or mock tooling.
ARG BASE_IMAGE=ecocode-backend:latest
FROM ${BASE_IMAGE}
USER root
RUN set -eu; \
    python -m compileall -b -q -j 0 /app/app /app/alembic; \
    find /app/app /app/alembic -name '*.py' -delete; \
    find /app/app /app/alembic -name '__pycache__' -type d -prune -exec rm -rf {} +; \
    rm -rf /app/bin /app/Dockerfile /app/requirements.txt /app/tests; \
    sed -i 's/^script_location = alembic$/script_location = alembic\nsourceless = true/' /app/alembic.ini; \
    chown -R app:app /app
USER app
ENV MOCK_CLI=0
