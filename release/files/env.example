# EcoCode Gateway - production settings. Copy to .env, fill every <...>, chmod 600.
# Generate secrets with the commands shown; never reuse the example values.

# Release version (matches the image tags inside images/*.tar.gz)
ECOCODE_VERSION=__VERSION__

# Where the web container listens. Keep 127.0.0.1 so only the host nginx reaches it.
BIND_ADDR=127.0.0.1
WEB_PORT=8085

# Session cookie is HTTPS-only. Keep true when the site is served over https://.
COOKIE_SECURE=true

# --- Secrets -----------------------------------------------------------------
# python3 -c 'import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
ECOCODE_SECRET_KEY=<fernet-key>
# openssl rand -hex 32
SESSION_SECRET=<random-hex>
# openssl rand -hex 24
POSTGRES_PASSWORD=<random-hex>
# openssl rand -hex 32   (shared secret for backend-internal endpoints)
INTERNAL_API_KEY=<random-hex>

# --- Initial admin (created on first start only) -----------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=<admin@your-domain>
ADMIN_PASSWORD=<strong-password>

# --- Claude subscription login -----------------------------------------------
# Absolute path of the ~/.claude folder of the Linux user (UID 1000) that ran
# `claude` + `/login` on this server. Mounted read-only.
CLAUDE_CREDS_DIR=/home/<deploy-user>/.claude
UPSTREAM_MODE=cli_creds
UPSTREAM_BASE_URL=https://api.anthropic.com
UPSTREAM_OAUTH_TOKEN_URL=https://console.anthropic.com/v1/oauth/token

# --- Capacity -------------------------------------------------------------------
CLI_MAX_CONCURRENCY=4
CLI_TIMEOUT_SECONDS=300
BACKEND_MEM_LIMIT=6g

# --- Optional -------------------------------------------------------------------
# Outbound proxy if the server cannot reach api.anthropic.com directly
HTTP_PROXY=
HTTPS_PROXY=
# LDAP login (leave false for local accounts)
LDAP_ENABLED=false
LDAP_URI=
LDAP_BASE_DN=
LDAP_BIND_TEMPLATE=
