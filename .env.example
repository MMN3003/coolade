# Copy to .env and adjust for your environment.
# Defaults below bring up the WHOLE stack with zero real credentials
# (UPSTREAM_MODE=mock, MOCK_CLI=1) — see README.md "Quick start".

# --- عمومی ---
# Product name shown in the UI (title, logo, login) and its technical id
# (docker project/volume prefix, cookie name, API key prefix "<slug>_live_").
APP_NAME=Coolade
APP_SLUG=coolade
COOLADE_ENV=dev                       # prod | dev
COOKIE_SECURE=                        # empty → Secure cookie only when prod; set false for prod over plain HTTP
UPSTREAM_MODE=mock                    # mock | cli_creds | apikey  (dev/verification default = mock; prod = cli_creds)
UPSTREAM_BASE_URL=https://claude-compat.example.com   # آدرس سرویس Claude-سازگار — فقط در mode cli_creds/apikey استفاده می‌شود

# --- OAuth refresh (Issue B، §4.1) ---
UPSTREAM_OAUTH_TOKEN_URL=             # خالی → پیش‌فرض: ${UPSTREAM_BASE_URL}/v1/oauth/token
UPSTREAM_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e   # client_id خود Claude Code (پیش‌فرض)

# --- CLI Runner ---
# مسیر اعتبارنامهٔ Claude Code روی هاست (mount :ro) — فقط mode cli_creds.
# نکته: docker compose علامت "~" را expand نمی‌کند؛ در prod یک مسیر مطلق واقعی
# بدهید (مثلاً /home/deploy/.claude). پیش‌فرض یک پوشهٔ خالی داخل ریپو برای dev/mock است.
CLAUDE_CREDS_DIR=./data/claude-creds
CLI_MAX_CONCURRENCY=4
CLI_TIMEOUT_SECONDS=300
MOCK_CLI=1                            # 1 → runner به‌جای claude واقعی، bin/mock-claude را اجرا می‌کند
THINKING_MAX_LEVEL=deep               # سقف سراسری سطح تفکر (Issue D): off | standard | deep

# --- اصلاحیهٔ ۳ ---
ROLLING_WINDOW_HOURS=5                 # طول پنجرهٔ غلتان سقف ۵ساعته (Issue E)
UPSTREAM_LIMIT_PROBE_ENABLED=false    # probe دوره‌ای سبک برای تازه‌کردن لیمیت اکانت (Issue F)
UPSTREAM_LIMIT_PROBE_INTERVAL=900     # ثانیه؛ فقط اگر probe فعال باشد

# --- رمزنگاری ---
COOLADE_SECRET_KEY=P6Je5cRHJMtTMauli5_0B7HgdghUsyvTxaFeio2YTcU=   # Fernet key (32-byte base64) — برای prod تغییر دهید
SESSION_SECRET=change-me-64-hex-please-generate-a-real-random-secret-value

# --- دیتابیس ---
POSTGRES_PASSWORD=coolade_dev_pw
COOLADE_DATABASE_URL=postgresql+asyncpg://coolade:${POSTGRES_PASSWORD}@postgres:5432/coolade
LITELLM_DATABASE_URL=postgresql://litellm:${POSTGRES_PASSWORD}@postgres:5432/litellm

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-master-dev-change-me
LITELLM_BASE_URL=http://litellm:4000
MOCK_UPSTREAM_BASE=http://mock-upstream:8080
BACKEND_INTERNAL_URL=http://backend:8000

# --- Outbound proxy (اختیاری، برای تانل به آپ‌استریم) ---
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=litellm,backend,postgres,mock-upstream,localhost,127.0.0.1

# --- LDAP (فاز P3، می‌تواند خالی بماند) ---
LDAP_ENABLED=false
LDAP_URI=ldaps://ldap.corp.local:636
LDAP_BASE_DN=ou=people,dc=corp,dc=local
LDAP_BIND_TEMPLATE=uid={username},ou=people,dc=corp,dc=local

# --- ادمین اولیه (seed در اولین اجرا) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_EMAIL=admin@example.local

# --- nginx ---
NGINX_HTTP_PORT=8085
